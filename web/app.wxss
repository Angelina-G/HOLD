page {
  background: #fbf7f3;
  color: #2f2a33;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}

view,
text,
button {
  box-sizing: border-box;
  overflow-wrap: break-word;
}

button {
  width: 100%;
  max-width: 100%;
  margin: 0;
  padding-left: 18rpx;
  padding-right: 18rpx;
}
