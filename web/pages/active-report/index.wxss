.report-page {
  min-height: 100vh;
  padding: 28rpx;
  background:
    radial-gradient(circle at 12% 8%, rgba(255, 176, 145, 0.3), transparent 34%),
    radial-gradient(circle at 88% 12%, rgba(196, 170, 255, 0.26), transparent 36%),
    linear-gradient(180deg, #fff9f4 0%, #f7f1ff 52%, #fff7ef 100%);
}

.report-hero,
.report-panel {
  border-radius: 28rpx;
  background: rgba(255, 253, 250, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 46rpx rgba(168, 132, 188, 0.12);
}

.report-hero {
  padding: 30rpx;
  background: linear-gradient(135deg, #f59b88 0%, #b89af6 100%);
  color: #332a31;
}

.report-tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.66);
  color: #6a536f;
  font-size: 22rpx;
  font-weight: 700;
}

.report-title {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.18;
}

.report-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #5d535b;
}

.report-panel {
  margin-top: 22rpx;
  padding: 28rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #332a31;
}

.metrics-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 20rpx;
}

.report-metric {
  padding: 18rpx;
  border-radius: 20rpx;
  background: #fff6ef;
  min-width: 0;
}

.report-metric-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #332a31;
}

.report-metric-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #81747d;
}

.readiness-line,
.comparison-copy,
.comparison-note {
  margin-top: 14rpx;
  color: #5d535b;
  font-size: 24rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.comparison-panel.peace {
  background: linear-gradient(135deg, rgba(227, 247, 240, 0.96), rgba(224, 240, 250, 0.96));
}

.comparison-panel.anxious {
  background: linear-gradient(135deg, rgba(255, 239, 229, 0.96), rgba(255, 226, 232, 0.96));
}

.comparison-state {
  margin-top: 16rpx;
  color: #332a31;
  font-size: 30rpx;
  font-weight: 700;
}

.comparison-values {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
  color: #51464e;
  font-size: 24rpx;
}

.comparison-note {
  color: #81747d;
  font-size: 21rpx;
}

.wave-grid {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  margin-top: 22rpx;
  height: 130rpx;
}

.wave-col {
  flex: 1;
}

.wave-bar-shell {
  display: flex;
  align-items: flex-end;
  height: 100rpx;
}

.wave-bar {
  width: 100%;
  border-radius: 999rpx 999rpx 16rpx 16rpx;
  background: linear-gradient(180deg, #f59b88 0%, #b89af6 100%);
}

.wave-label {
  margin-top: 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: #81747d;
}

.section-block {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(106, 83, 111, 0.08);
}

.section-block:first-of-type {
  border-top: none;
  padding-top: 0;
}

.section-heading {
  font-size: 26rpx;
  font-weight: 700;
  color: #332a31;
}

.section-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #5d535b;
}

.empty-report {
  margin-top: 30vh;
  text-align: center;
}

.history-button {
  min-height: 82rpx;
  margin-top: 24rpx;
  border-radius: 16rpx;
  background: #40343f;
  color: #fffaf8;
  font-size: 26rpx;
}

@media (max-width: 360px) {
  .metrics-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .comparison-values {
    grid-template-columns: 1fr;
  }

  .report-metric-value {
    font-size: 25rpx;
    overflow-wrap: anywhere;
  }
}
