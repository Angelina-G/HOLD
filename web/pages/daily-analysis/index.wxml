<view class="daily-page" wx:if="{{activeDay}}">
  <view class="daily-hero">
    <view class="hero-title">当日呼吸与心跳分析</view>
    <view class="hero-subtitle">查看今日近期有效数据；连接设备时，数值和趋势会随硬件遥测自动更新。</view>
  </view>

  <scroll-view class="day-tabs" scroll-x="true" enable-flex="true">
    <block wx:for="{{dailyAnalyses}}" wx:key="day">
      <view class="day-tab {{index === activeIndex ? 'active' : ''}}" bindtap="switchDay" data-index="{{index}}">
        <view class="day-tab-date">{{item.day}}</view>
        <view class="day-tab-label">{{item.title}}</view>
      </view>
    </block>
  </scroll-view>

  <view class="stats-grid">
    <view class="stat-card breath">
      <view class="stat-value">{{activeDay.respirationAvg}}</view>
      <view class="stat-unit">次/分</view>
      <view class="stat-label">平均呼吸率</view>
    </view>
    <view class="stat-card heart">
      <view class="stat-value">{{activeDay.heartRateAvg}}</view>
      <view class="stat-unit">bpm</view>
      <view class="stat-label">平均心率</view>
    </view>
    <view class="stat-card stable">
      <view class="stat-value">{{activeDay.stabilityScore}}</view>
      <view class="stat-unit" wx:if="{{activeDay.stabilityScore != '--'}}">/100</view>
      <view class="stat-label">数据完整度</view>
    </view>
  </view>

  <view class="comparison-panel {{activeDay.comparison.tone}}" wx:if="{{activeDay.comparison}}">
    <view class="comparison-heading">
      <view>
      <view class="comparison-eyebrow">本次变化指数 · 非医学评估</view>
        <view class="panel-title">{{activeDay.comparison.stateLabel}}</view>
      </view>
      <view class="comparison-score" wx:if="{{activeDay.comparison.hasCompositeScore}}">{{activeDay.comparison.score}}<text>/100</text></view>
    </view>
    <view class="before-after-grid" wx:if="{{activeDay.comparison.ready}}">
      <view class="period-card before">
        <view class="period-name">引导前 · 基线</view>
        <view class="period-value">{{activeDay.comparison.beforeHr}} <text>bpm</text></view>
        <view class="period-value secondary">{{activeDay.comparison.beforeBr}} <text>次/分</text></view>
      </view>
      <view class="period-card after {{activeDay.comparison.tone}}">
        <view class="period-name">引导后 · {{activeDay.comparison.stateLabel}}</view>
        <view class="period-value">{{activeDay.comparison.afterHr}} <text>bpm</text></view>
        <view class="period-value secondary">{{activeDay.comparison.afterBr}} <text>次/分</text></view>
      </view>
    </view>
    <view class="period-delta" wx:if="{{activeDay.comparison.ready}}">心率变化 {{activeDay.comparison.hrDeltaLabel}} · 呼吸变化 {{activeDay.comparison.brDeltaLabel}}</view>
    <view class="comparison-copy">{{activeDay.comparison.verdict}}</view>
  <view class="comparison-fineprint" wx:if="{{activeDay.comparison.ready}}">{{activeDay.comparison.confidenceLabel}} · {{activeDay.comparison.validSampleLabel}}，该结果不是医学诊断。</view>
  </view>

  <view class="chart-panel">
    <view class="panel-title">呼吸相对趋势 · 自动缩放</view>
    <view class="bars-row">
      <block wx:for="{{activeDay.respirationBars}}" wx:key="index">
        <view class="bar-slot">
          <view class="bar breath-bar" style="height: {{item}}rpx"></view>
        </view>
      </block>
    </view>
  </view>

  <view class="chart-panel">
    <view class="panel-title">心率相对趋势 · 自动缩放</view>
    <view class="bars-row">
      <block wx:for="{{activeDay.heartRateBars}}" wx:key="index">
        <view class="bar-slot">
          <view class="bar heart-bar" style="height: {{item}}rpx"></view>
        </view>
      </block>
    </view>
  </view>

  <view class="chart-panel">
    <view class="panel-title">当日观察</view>
    <view class="insight-copy">{{activeDay.insight}}</view>

    <view class="timeline-list">
      <block wx:for="{{activeDay.timeline}}" wx:key="time">
        <view class="timeline-row">
          <view class="timeline-time">{{item.time}}</view>
          <view class="timeline-dot {{item.tone}}"></view>
          <view class="timeline-text">{{item.label}}</view>
        </view>
      </block>
    </view>
  </view>
</view>
