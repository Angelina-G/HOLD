.daily-page {
  min-height: 100vh;
  padding: 28rpx;
  background:
    radial-gradient(circle at 12% 8%, rgba(255, 176, 145, 0.3), transparent 34%),
    radial-gradient(circle at 88% 12%, rgba(196, 170, 255, 0.26), transparent 36%),
    linear-gradient(180deg, #fff9f4 0%, #f7f1ff 52%, #fff7ef 100%);
}

.daily-hero,
.chart-panel,
.day-tab,
.stat-card {
  border-radius: 26rpx;
}

.daily-hero,
.chart-panel,
.stat-card {
  background: rgba(255, 252, 246, 0.95);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 46rpx rgba(168, 132, 188, 0.12);
}

.daily-hero {
  padding: 30rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #332a31;
  line-height: 1.18;
}

.hero-subtitle {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #756a73;
}

.day-tabs {
  margin-top: 22rpx;
  white-space: nowrap;
}

.day-tab {
  display: inline-flex;
  flex-direction: column;
  justify-content: center;
  min-width: 150rpx;
  margin-right: 16rpx;
  padding: 20rpx;
  background: rgba(255, 249, 245, 0.78);
}

.day-tab.active {
  background: linear-gradient(135deg, #f59b88 0%, #b89af6 100%);
}

.day-tab-date {
  font-size: 28rpx;
  font-weight: 700;
  color: #332a31;
}

.day-tab-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #81747d;
}

.day-tab.active .day-tab-date,
.day-tab.active .day-tab-label {
  color: #fffaf7;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 22rpx;
}

.stat-card {
  padding: 22rpx 18rpx;
  min-width: 0;
}

.stat-card.breath {
  background: #fff0e9;
}

.stat-card.heart {
  background: #f3efff;
}

.stat-card.stable {
  background: #fff7e9;
}

.stat-value {
  font-size: 42rpx;
  font-weight: 700;
  color: #332a31;
}

.stat-unit,
.stat-label {
  display: block;
}

.stat-unit {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #81747d;
}

.stat-label {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #756a73;
}

.chart-panel {
  margin-top: 22rpx;
  padding: 28rpx;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #332a31;
}

.bars-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  height: 120rpx;
}

.bar-slot {
  flex: 1;
  display: flex;
  align-items: flex-end;
  height: 100rpx;
}

.bar {
  width: 100%;
  border-radius: 999rpx 999rpx 14rpx 14rpx;
}

.breath-bar {
  background: linear-gradient(180deg, #f2a59a 0%, #c9a7f5 100%);
}

.heart-bar {
  background: linear-gradient(180deg, #b89af6 0%, #f59b88 100%);
}

.insight-copy {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #5d535b;
}

.timeline-list {
  margin-top: 18rpx;
}

.timeline-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
}

.timeline-time {
  width: 90rpx;
  font-size: 22rpx;
  color: #81747d;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.timeline-dot.soft {
  background: #c9a7f5;
}

.timeline-dot.warm {
  background: #f59b88;
}

.timeline-dot.strong {
  background: #8f75d8;
}

.timeline-text {
  flex: 1;
  font-size: 24rpx;
  color: #5d535b;
}
