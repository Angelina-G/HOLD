.home-page {
  min-height: 100vh;
  padding: 28rpx;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 14% 8%, rgba(255, 176, 145, 0.34), transparent 32%),
    radial-gradient(circle at 88% 14%, rgba(196, 170, 255, 0.28), transparent 34%),
    radial-gradient(circle at 50% 48%, rgba(255, 221, 169, 0.24), transparent 34%),
    linear-gradient(180deg, #fff9f4 0%, #f7f1ff 48%, #fff7ef 100%);
}

.home-hero {
  padding: 34rpx 32rpx;
  border-radius: 34rpx;
  background:
    linear-gradient(135deg, rgba(255, 238, 224, 0.92) 0%, rgba(242, 239, 255, 0.95) 100%);
  color: #332a31;
  border: 1rpx solid rgba(199, 167, 255, 0.22);
  box-shadow: 0 24rpx 64rpx rgba(168, 132, 188, 0.16);
}

.hero-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
}

.hero-row > view:first-child,
.module-header > view:first-child {
  flex: 1;
  min-width: 0;
}

.hero-badge {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.62);
  color: #8b5a73;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.15;
}

.hero-subtitle {
  margin-top: 12rpx;
  max-width: 520rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #746b70;
}

.debug-entry {
  height: fit-content;
  flex: 0 0 auto;
  max-width: 170rpx;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #5b4764;
  font-size: 22rpx;
  line-height: 1.25;
  text-align: center;
}

.hero-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 28rpx;
}

.hero-chip {
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.62);
  min-width: 0;
}

.test-entry {
  display: flex;
  min-height: 104rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  border-radius: 18rpx;
  background: #40343f;
  color: #fffaf8;
  text-align: left;
}

.test-entry-title,
.test-entry-copy {
  display: block;
  width: 100%;
}

.test-entry-title {
  font-size: 28rpx;
  font-weight: 700;
}

.test-entry-copy {
  margin-top: 6rpx;
  color: #eadfe7;
  font-size: 21rpx;
}

.chip-label {
  display: block;
  font-size: 22rpx;
  color: #81747d;
}

.chip-value {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #352f36;
}

.module-card {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: rgba(255, 251, 244, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 48rpx rgba(168, 132, 188, 0.12);
  overflow: hidden;
}

.highlight-card {
  background: rgba(255, 253, 250, 0.94);
}

.analysis-card {
  background: rgba(255, 252, 255, 0.94);
}

.advice-card {
  background: rgba(255, 253, 250, 0.94);
}

.mode-card {
  background:
    linear-gradient(135deg, rgba(255, 248, 241, 0.96), rgba(245, 251, 255, 0.92));
}

.module-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.module-header.simple {
  align-items: center;
}

.module-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #fff0dc;
  color: #8c5c4f;
  font-size: 20rpx;
  font-weight: 700;
}

.module-title {
  margin-top: 14rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #332a31;
  line-height: 1.25;
}

.module-action {
  flex: 0 0 auto;
  max-width: 190rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f59b88 0%, #b89af6 100%);
  color: #332a31;
  font-size: 22rpx;
  line-height: 1.25;
  text-align: center;
}

.summary-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.ppg-mode-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.ppg-mode {
  min-width: 0;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.74);
  border: 2rpx solid rgba(222, 210, 220, 0.55);
}

.ppg-mode.active {
  background: linear-gradient(135deg, rgba(230, 249, 244, 0.88), rgba(239, 246, 255, 0.9));
  border-color: rgba(101, 170, 162, 0.35);
}

.ppg-mode.finger {
  background: linear-gradient(135deg, rgba(255, 244, 238, 0.94), rgba(246, 239, 255, 0.9));
}

.mode-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #332a31;
  line-height: 1.25;
}

.mode-state {
  margin-top: 8rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.peace-text {
  color: #4f918c;
}

.warm-text {
  color: #cf7569;
}

.mode-copy {
  margin-top: 12rpx;
  color: #756a73;
  font-size: 22rpx;
  line-height: 1.55;
}

.summary-pill {
  padding: 18rpx;
  border-radius: 20rpx;
  background: #fff6ef;
  min-width: 0;
}

.summary-value {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #332a31;
}

.summary-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #81747d;
}

.mini-chart,
.line-preview,
.trend-card {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 249, 245, 0.78);
}

.live-wave-panel {
  margin-top: 24rpx;
  padding: 22rpx;
  border: 2rpx solid #e8dfdf;
  border-radius: 22rpx;
  background: #fffdfb;
  overflow: hidden;
}

.breath-wave-panel {
  margin-top: 24rpx;
  padding: 22rpx;
  border: 2rpx solid rgba(233, 225, 230, 0.9);
  border-radius: 22rpx;
  background: #fffdfb;
  overflow: hidden;
}

.breath-wave-panel.peace {
  border-color: rgba(101, 170, 162, 0.28);
  background: linear-gradient(135deg, rgba(241, 252, 248, 0.92), rgba(244, 250, 255, 0.92));
}

.breath-wave-panel.anxious {
  border-color: rgba(238, 141, 127, 0.32);
  background: linear-gradient(135deg, rgba(255, 244, 238, 0.96), rgba(255, 249, 245, 0.92));
}

.breath-wave-canvas {
  display: block;
  width: 100%;
  height: 200rpx;
  margin-top: 16rpx;
}

.live-wave-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.live-wave-caption {
  margin-top: 6rpx;
  color: #81747d;
  font-size: 20rpx;
}

.live-dot {
  width: 14rpx;
  height: 14rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #5b9f98;
}

.live-dot.off {
  background: #b8b3b6;
  box-shadow: none;
}

.home-live-canvas {
  display: block;
  width: 100%;
  height: 220rpx;
  margin-top: 16rpx;
}

.mini-chart-title,
.line-preview-title,
.trend-title {
  font-size: 24rpx;
  color: #756a73;
}

.chart-columns,
.trend-bars,
.line-track {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  margin-top: 18rpx;
  height: 120rpx;
}

.chart-column,
.trend-item {
  flex: 1;
}

.chart-bar-wrap {
  display: flex;
  align-items: flex-end;
  height: 100rpx;
}

.chart-bar,
.trend-bar,
.spark-node {
  width: 100%;
  border-radius: 999rpx 999rpx 16rpx 16rpx;
}

.active-bar {
  background: linear-gradient(180deg, #f2a59a 0%, #b69ef5 100%);
}

.chart-label {
  margin-top: 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: #81747d;
}

.module-copy,
.advice-copy {
  margin-top: 22rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: #5d535b;
}

.wellbeing-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #faf8f8;
  border: 2rpx solid rgba(233, 225, 230, 0.9);
}

.wellbeing-card.peace {
  background:
    radial-gradient(circle at 86% 14%, rgba(175, 221, 216, 0.34), transparent 42%),
    linear-gradient(135deg, rgba(238, 249, 245, 0.96), rgba(242, 249, 255, 0.94));
  border-color: rgba(101, 170, 162, 0.28);
}

.wellbeing-card.anxious {
  background:
    radial-gradient(circle at 86% 12%, rgba(245, 155, 136, 0.3), transparent 42%),
    linear-gradient(135deg, rgba(255, 244, 238, 0.98), rgba(250, 240, 255, 0.94));
  border-color: rgba(238, 141, 127, 0.3);
}

.wellbeing-card.low {
  background:
    radial-gradient(circle at 86% 12%, rgba(170, 187, 224, 0.26), transparent 42%),
    linear-gradient(135deg, rgba(246, 248, 255, 0.98), rgba(240, 250, 255, 0.94));
  border-color: rgba(143, 158, 204, 0.28);
}

.wellbeing-copy {
  flex: 1;
  min-width: 0;
}

.wellbeing-kicker {
  color: #81747d;
  font-size: 20rpx;
  font-weight: 700;
}

.wellbeing-title {
  margin-top: 8rpx;
  color: #332a31;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.24;
}

.wellbeing-note {
  margin-top: 10rpx;
  color: #5d535b;
  font-size: 23rpx;
  line-height: 1.6;
}

.state-zones {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.state-zone {
  min-width: 0;
  padding: 10rpx 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.56);
  color: #81747d;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
}

.state-zone.active.peace {
  background: #e3f5ef;
  color: #3f837b;
}

.state-zone.active.bright {
  background: #fff0de;
  color: #aa7250;
}

.state-zone.active.anxious {
  background: #ffe7de;
  color: #b35e50;
}

.state-zone.active.low {
  background: #eef2ff;
  color: #6870a6;
}

.wellbeing-score {
  flex: 0 0 116rpx;
  min-height: 116rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.68);
  color: #4f918c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 700;
}

.anxious .wellbeing-score {
  color: #cf7569;
}

.low .wellbeing-score {
  color: #6870a6;
}

.comparison-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 2rpx solid #e9e1e6;
  border-radius: 22rpx;
  background: #faf8f8;
}

.comparison-card.peace {
  border-color: #b9ddd5;
  background: #eef8f5;
}

.comparison-card.anxious {
  border-color: #f0c0ae;
  background: #fff2ec;
}

.comparison-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.comparison-kicker,
.comparison-note,
.paired-caption,
.delta-label {
  color: #756a73;
  font-size: 20rpx;
}

.comparison-title {
  margin-top: 6rpx;
  color: #332a31;
  font-size: 30rpx;
  font-weight: 700;
}

.calm-score {
  flex: 0 0 auto;
  color: #315f5b;
  font-size: 40rpx;
  font-weight: 700;
}

.anxious .calm-score {
  color: #a65340;
}

.score-unit {
  font-size: 20rpx;
  font-weight: 500;
}

.comparison-chart {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 22rpx;
}

.compare-metric {
  min-width: 0;
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
}

.compare-label {
  color: #5d535b;
  font-size: 22rpx;
  font-weight: 600;
}

.paired-bars {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 18rpx;
  height: 144rpx;
  margin-top: 10rpx;
}

.paired-column {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.paired-value {
  color: #332a31;
  font-size: 22rpx;
  font-weight: 700;
}

.compare-bar {
  width: 42rpx;
  margin: 6rpx 0;
  border-radius: 18rpx 18rpx 6rpx 6rpx;
}

.warm-column .compare-bar {
  background: #9b8eb0;
}

.after-column.peace .compare-bar {
  background: #62a9a0;
}

.after-column.anxious .compare-bar {
  background: #d86f5d;
}

.after-column.neutral .compare-bar {
  background: #9b8eb0;
}

.delta-label {
  margin-top: 10rpx;
  text-align: center;
}

.comparison-verdict {
  margin-top: 18rpx;
  color: #4f464d;
  font-size: 24rpx;
  line-height: 1.65;
}

.comparison-note {
  margin-top: 8rpx;
}

.double-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
  width: 100%;
  overflow: hidden;
}

.solid-button,
.outline-button {
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: 1.35;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  padding-left: 16rpx;
  padding-right: 16rpx;
}

.solid-button {
  background: linear-gradient(135deg, #f59b88 0%, #b89af6 100%);
  color: #332a31;
}

.outline-button {
  background: rgba(255, 255, 255, 0.62);
  color: #6a536f;
  border: 2rpx solid rgba(184, 154, 246, 0.22);
}

.analysis-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.analysis-stat {
  padding: 22rpx 18rpx;
  border-radius: 22rpx;
  min-width: 0;
}

.analysis-stat.breathing {
  background: #fff0e9;
}

.analysis-stat.heartbeat {
  background: #f3efff;
}

.analysis-stat.stability {
  background: #fff7e9;
}

.analysis-number {
  font-size: 42rpx;
  font-weight: 700;
  color: #332a31;
}

.analysis-unit,
.analysis-label {
  display: block;
}

.analysis-unit {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #81747d;
}

.analysis-label {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #756a73;
}

.spark-node {
  flex: 1;
  background: linear-gradient(180deg, #f59b88 0%, #b89af6 100%);
}

.ring-shell {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: conic-gradient(#f59b88 0deg, #b89af6 280deg, rgba(184, 154, 246, 0.18) 280deg, rgba(184, 154, 246, 0.18) 360deg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-core {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #fffaf7;
  color: #332a31;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.bullet-list {
  margin-top: 20rpx;
}

.bullet-row {
  display: flex;
  gap: 14rpx;
  padding: 10rpx 0;
}

.bullet-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #f59b88;
}

.bullet-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5d535b;
}

@media (max-width: 360px) {
  .hero-metrics,
  .summary-strip,
  .analysis-grid,
  .double-actions,
  .ppg-mode-grid,
  .comparison-chart {
    grid-template-columns: 1fr;
  }

  .wellbeing-card {
    align-items: stretch;
    flex-direction: column;
  }

  .wellbeing-score {
    flex-basis: auto;
    min-height: 82rpx;
  }
}
