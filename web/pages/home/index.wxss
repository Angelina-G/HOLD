.home-page {
  min-height: 100vh;
  padding: 28rpx;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 14% 8%, rgba(255, 176, 145, 0.34), transparent 32%),
    radial-gradient(circle at 88% 14%, rgba(196, 170, 255, 0.28), transparent 34%),
    radial-gradient(circle at 50% 48%, rgba(255, 221, 169, 0.24), transparent 34%),
    linear-gradient(180deg, #fff9f4 0%, #f7f1ff 48%, #fff7ef 100%);
}

.home-hero {
  padding: 34rpx 32rpx;
  border-radius: 34rpx;
  background:
    linear-gradient(135deg, rgba(255, 238, 224, 0.92) 0%, rgba(242, 239, 255, 0.95) 100%);
  color: #332a31;
  border: 1rpx solid rgba(199, 167, 255, 0.22);
  box-shadow: 0 24rpx 64rpx rgba(168, 132, 188, 0.16);
}

.hero-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
}

.hero-row > view:first-child,
.module-header > view:first-child {
  flex: 1;
  min-width: 0;
}

.hero-badge {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.62);
  color: #8b5a73;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.15;
}

.hero-subtitle {
  margin-top: 12rpx;
  max-width: 520rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #746b70;
}

.debug-entry {
  height: fit-content;
  flex: 0 0 auto;
  max-width: 170rpx;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #5b4764;
  font-size: 22rpx;
  line-height: 1.25;
  text-align: center;
}

.hero-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 28rpx;
}

.hero-chip {
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.62);
  min-width: 0;
}

.chip-label {
  display: block;
  font-size: 22rpx;
  color: #81747d;
}

.chip-value {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #352f36;
}

.module-card {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: rgba(255, 251, 244, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 48rpx rgba(168, 132, 188, 0.12);
  overflow: hidden;
}

.highlight-card {
  background: rgba(255, 253, 250, 0.94);
}

.analysis-card {
  background: rgba(255, 252, 255, 0.94);
}

.advice-card {
  background: rgba(255, 253, 250, 0.94);
}

.module-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.module-header.simple {
  align-items: center;
}

.module-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #fff0dc;
  color: #8c5c4f;
  font-size: 20rpx;
  font-weight: 700;
}

.module-title {
  margin-top: 14rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #332a31;
  line-height: 1.25;
}

.module-action {
  flex: 0 0 auto;
  max-width: 190rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f59b88 0%, #b89af6 100%);
  color: #fffaf7;
  font-size: 22rpx;
  line-height: 1.25;
  text-align: center;
}

.summary-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.summary-pill {
  padding: 18rpx;
  border-radius: 20rpx;
  background: #fff6ef;
  min-width: 0;
}

.summary-value {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #332a31;
}

.summary-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #81747d;
}

.mini-chart,
.line-preview,
.trend-card {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 249, 245, 0.78);
}

.mini-chart-title,
.line-preview-title,
.trend-title {
  font-size: 24rpx;
  color: #756a73;
}

.chart-columns,
.trend-bars,
.line-track {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  margin-top: 18rpx;
  height: 120rpx;
}

.chart-column,
.trend-item {
  flex: 1;
}

.chart-bar-wrap {
  display: flex;
  align-items: flex-end;
  height: 100rpx;
}

.chart-bar,
.trend-bar,
.spark-node {
  width: 100%;
  border-radius: 999rpx 999rpx 16rpx 16rpx;
}

.active-bar {
  background: linear-gradient(180deg, #f2a59a 0%, #b69ef5 100%);
}

.chart-label {
  margin-top: 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: #81747d;
}

.module-copy,
.advice-copy {
  margin-top: 22rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: #5d535b;
}

.double-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
  width: 100%;
  overflow: hidden;
}

.solid-button,
.outline-button {
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: 1.35;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  padding-left: 16rpx;
  padding-right: 16rpx;
}

.solid-button {
  background: linear-gradient(135deg, #f59b88 0%, #b89af6 100%);
  color: #fffaf7;
}

.outline-button {
  background: rgba(255, 255, 255, 0.62);
  color: #6a536f;
  border: 2rpx solid rgba(184, 154, 246, 0.22);
}

.analysis-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.analysis-stat {
  padding: 22rpx 18rpx;
  border-radius: 22rpx;
  min-width: 0;
}

.analysis-stat.breathing {
  background: #fff0e9;
}

.analysis-stat.heartbeat {
  background: #f3efff;
}

.analysis-stat.stability {
  background: #fff7e9;
}

.analysis-number {
  font-size: 42rpx;
  font-weight: 700;
  color: #332a31;
}

.analysis-unit,
.analysis-label {
  display: block;
}

.analysis-unit {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #81747d;
}

.analysis-label {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #756a73;
}

.spark-node {
  flex: 1;
  background: linear-gradient(180deg, #f59b88 0%, #b89af6 100%);
}

.ring-shell {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: conic-gradient(#f59b88 0deg, #b89af6 280deg, rgba(184, 154, 246, 0.18) 280deg, rgba(184, 154, 246, 0.18) 360deg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-core {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #fffaf7;
  color: #332a31;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.bullet-list {
  margin-top: 20rpx;
}

.bullet-row {
  display: flex;
  gap: 14rpx;
  padding: 10rpx 0;
}

.bullet-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #f59b88;
}

.bullet-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5d535b;
}

@media (max-width: 640rpx) {
  .hero-metrics,
  .summary-strip,
  .analysis-grid,
  .double-actions {
    grid-template-columns: 1fr;
  }
}
