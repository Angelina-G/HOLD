<view class="home-page">
  <view class="home-hero">
    <view class="hero-row">
      <view>
        <view class="hero-badge">USER PREVIEW</view>
        <view class="hero-title">HOLD 健康主页</view>
        <view class="hero-subtitle">先保留调试链路，用户界面以主动检测、当日分析和近期建议为主。</view>
      </view>
      <view class="debug-entry" bindtap="openDebugPage">调试页</view>
    </view>

    <view class="hero-metrics">
      <view class="hero-chip">
        <text class="chip-label">最近检测</text>
        <text class="chip-value">{{latestMeasurement.startedAt}}</text>
      </view>
      <view class="hero-chip">
        <text class="chip-label">本次平均心率</text>
        <text class="chip-value">{{latestDaily.heartRateAvg}} bpm</text>
      </view>
      <view class="hero-chip">
        <text class="chip-label">近期准备度</text>
        <text class="chip-value">{{homeOverview.readinessScore}} / 100</text>
      </view>
    </view>

    <button class="test-entry" bindtap="openUserTest">
      <text class="test-entry-title">开始一次舒缓测试</text>
      <text class="test-entry-copy">约 2 分钟 · 测量、引导、前后对比</text>
    </button>
  </view>

  <view class="module-card mode-card">
    <view class="module-header simple">
      <view>
        <view class="module-tag">PPG 模式</view>
        <view class="module-title">胸口连续，指部主动</view>
      </view>
    </view>
    <view class="ppg-mode-grid">
      <view class="ppg-mode active" bindtap="selectChestMode">
        <view class="mode-name">胸口 PPG</view>
        <view class="mode-state peace-text">默认常开</view>
        <view class="mode-copy">用于连续观察心率、呼吸和放松趋势。</view>
      </view>
      <view class="ppg-mode finger" bindtap="openFingerMode"
        >
        <view class="mode-name">指部 PPG</view>
        <view class="mode-state warm-text">压敏 3 秒开始</view>
        <view class="mode-copy">进入后用手指压住硬件压敏，设备会自动确认指部采集。</view>
      </view>
    </view>
  </view>

  <view class="module-card highlight-card">
    <view class="module-header">
      <view>
        <view class="module-tag">主动检测</view>
        <view class="module-title">指部 PPG 历史与报告</view>
      </view>
      <view class="module-action" bindtap="openActiveHistory">查看历史</view>
    </view>

    <view class="summary-strip">
      <view class="summary-pill">
        <text class="summary-value">{{latestMeasurement.resultTag}}</text>
        <text class="summary-label">结果状态</text>
      </view>
      <view class="summary-pill">
        <text class="summary-value">{{latestMeasurement.durationLabel}}</text>
        <text class="summary-label">检测时长</text>
      </view>
      <view class="summary-pill">
        <text class="summary-value">{{latestMeasurement.metrics[0].value}}</text>
        <text class="summary-label">平均心率</text>
      </view>
    </view>

    <view class="mini-chart">
      <view class="mini-chart-title">{{latestMeasurement.waveformSource || '最近一次检测波形摘要'}}</view>
      <view class="chart-columns">
        <block wx:for="{{latestMeasurement.waveformMoments}}" wx:key="label">
          <view class="chart-column">
            <view class="chart-bar-wrap">
              <view class="chart-bar active-bar" style="height: {{item.value}}rpx"></view>
            </view>
            <view class="chart-label">{{item.label}}</view>
          </view>
        </block>
      </view>
    </view>

    <view class="module-copy">{{latestMeasurement.summary}}</view>

    <view class="double-actions">
      <button class="solid-button" bindtap="openActiveHistory">检测历史</button>
      <button class="outline-button" bindtap="openLatestReport">最近报告</button>
    </view>
  </view>

  <view class="module-card analysis-card">
    <view class="module-header">
      <view>
        <view class="module-tag">当日分析</view>
        <view class="module-title">呼吸与心跳分析</view>
      </view>
      <view class="module-action" bindtap="openDailyAnalysis">查看详情</view>
    </view>

    <view class="analysis-grid">
      <view class="analysis-stat breathing">
        <text class="analysis-number">{{latestDaily.respirationAvg}}</text>
        <text class="analysis-unit">次/分</text>
        <text class="analysis-label">平均呼吸率</text>
      </view>
      <view class="analysis-stat heartbeat">
        <text class="analysis-number">{{latestDaily.heartRateAvg}}</text>
        <text class="analysis-unit">bpm</text>
        <text class="analysis-label">平均心率</text>
      </view>
      <view class="analysis-stat stability">
        <text class="analysis-number">{{latestDaily.stabilityScore}}</text>
        <text class="analysis-unit" wx:if="{{latestDaily.stabilityScore != '--'}}">/100</text>
        <text class="analysis-label">数据完整度</text>
      </view>
    </view>

    <view class="wellbeing-card {{wellbeing.tone}}">
      <view class="wellbeing-copy">
        <view class="wellbeing-kicker">当前状态 · 非医学评估</view>
        <view class="wellbeing-title">{{wellbeing.title}}</view>
        <view class="wellbeing-note">{{wellbeing.copy}}</view>
        <view class="state-zones">
          <block wx:for="{{wellbeing.zoneItems}}" wx:key="key">
            <view class="state-zone {{item.key}} {{item.active ? 'active' : ''}}">{{item.label}}</view>
          </block>
        </view>
      </view>
      <view class="wellbeing-score">
        <text>{{wellbeing.score}}</text>
        <text class="score-unit" wx:if="{{wellbeing.score != '--'}}">/100</text>
      </view>
    </view>

    <view class="line-preview">
      <view class="line-preview-title">近 7 个采样时段相对趋势 · 自动缩放</view>
      <view class="line-track">
        <block wx:for="{{latestDaily.heartRateBars}}" wx:key="index">
          <view class="spark-node" style="height: {{item}}rpx"></view>
        </block>
      </view>
    </view>

    <view class="module-copy">{{latestDaily.insight}}</view>

    <view class="comparison-card {{latestDaily.comparison.tone}}" wx:if="{{latestDaily.comparison}}">
      <view class="comparison-head">
        <view>
      <view class="comparison-kicker">本次变化指数 · 非医学评估</view>
          <view class="comparison-title">{{latestDaily.comparison.stateLabel}}</view>
        </view>
        <view class="calm-score" wx:if="{{latestDaily.comparison.hasCompositeScore}}">
          <text>{{latestDaily.comparison.score}}</text><text class="score-unit">/100</text>
        </view>
      </view>

      <view class="comparison-chart" wx:if="{{latestDaily.comparison.ready}}">
        <view class="compare-metric">
          <view class="compare-label">心率 bpm</view>
          <view class="paired-bars">
            <view class="paired-column warm-column">
              <view class="paired-value">{{latestDaily.comparison.beforeHr}}</view>
              <view class="compare-bar" style="height: {{latestDaily.comparison.beforeHrHeight}}rpx"></view>
              <view class="paired-caption">引导前</view>
            </view>
            <view class="paired-column after-column {{latestDaily.comparison.tone}}">
              <view class="paired-value">{{latestDaily.comparison.afterHr}}</view>
              <view class="compare-bar" style="height: {{latestDaily.comparison.afterHrHeight}}rpx"></view>
              <view class="paired-caption">引导后</view>
            </view>
          </view>
          <view class="delta-label">变化 {{latestDaily.comparison.hrDeltaLabel}}</view>
        </view>

        <view class="compare-metric">
          <view class="compare-label">呼吸 次/分</view>
          <view class="paired-bars">
            <view class="paired-column warm-column">
              <view class="paired-value">{{latestDaily.comparison.beforeBr}}</view>
              <view class="compare-bar" style="height: {{latestDaily.comparison.beforeBrHeight}}rpx"></view>
              <view class="paired-caption">引导前</view>
            </view>
            <view class="paired-column after-column {{latestDaily.comparison.tone}}">
              <view class="paired-value">{{latestDaily.comparison.afterBr}}</view>
              <view class="compare-bar" style="height: {{latestDaily.comparison.afterBrHeight}}rpx"></view>
              <view class="paired-caption">引导后</view>
            </view>
          </view>
          <view class="delta-label">变化 {{latestDaily.comparison.brDeltaLabel}}</view>
        </view>
      </view>

      <view class="comparison-verdict">{{latestDaily.comparison.verdict}}</view>
    <view class="comparison-note" wx:if="{{latestDaily.comparison.ready}}">{{latestDaily.comparison.confidenceLabel}} · {{latestDaily.comparison.validSampleLabel}} · 仅反映本次生理变化趋势</view>
    </view>
  </view>

  <view class="module-card advice-card">
    <view class="module-header simple">
      <view>
        <view class="module-tag">近期建议</view>
        <view class="module-title">综合考量与建议</view>
      </view>
      <view class="ring-shell">
        <view class="ring-core">{{readinessRing}}</view>
      </view>
    </view>

    <view class="advice-copy">{{homeOverview.recentAdvice}}</view>

    <view class="trend-card">
      <view class="trend-title">近期综合评分趋势</view>
      <view class="trend-bars">
        <block wx:for="{{homeOverview.trendSeries}}" wx:key="index">
          <view class="trend-item">
            <view class="trend-bar" style="height: {{item}}rpx"></view>
          </view>
        </block>
      </view>
    </view>

    <view class="bullet-list">
      <block wx:for="{{homeOverview.recommendationBullets}}" wx:key="index">
        <view class="bullet-row">
          <view class="bullet-dot"></view>
          <view class="bullet-text">{{item}}</view>
        </view>
      </block>
    </view>
  </view>
</view>
