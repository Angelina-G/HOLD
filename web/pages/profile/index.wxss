.profile-page {
  min-height: 100vh;
}

.page-topbar {
  padding: 12rpx 4rpx 28rpx;
}

/* ---------- 登录卡片 ---------- */

.login-card {
  padding: 56rpx 40rpx 40rpx;
}

.login-head {
  text-align: center;
}

.login-avatar {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.9;
}

.login-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1b2419;
  letter-spacing: 1rpx;
  margin-bottom: 16rpx;
}

.login-head .app-body {
  text-align: left;
  margin: 0 auto;
}

.login-btn {
  margin-top: 40rpx;
}

.login-hint {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
}

.login-error {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #a4442c;
  text-align: center;
}

/* ---------- 账号卡 ---------- */

.account-card {
  padding: 28rpx 32rpx;
}

.account-row {
  display: flex;
  align-items: center;
}

.avatar-btn {
  width: 112rpx;
  height: 112rpx;
  padding: 0;
  margin: 0 24rpx 0 0;
  background: transparent;
  border-radius: 50%;
  flex: none;
  line-height: normal;
}

.account-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(47, 93, 58, 0.08);
}

.account-avatar--letter {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #2f5d3a;
  font-weight: 500;
}

.account-main {
  flex: 1;
  min-width: 0;
}

.account-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1b2419;
  letter-spacing: 1rpx;
}

.account-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
}

.account-edit {
  flex: none;
  font-size: 25rpx;
  color: #2f5d3a;
  padding: 8rpx 4rpx 8rpx 24rpx;
}

.nickname-editor {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(27, 36, 25, 0.06);
}

.nickname-input {
  height: 84rpx;
  padding: 0 24rpx;
  background: rgba(27, 36, 25, 0.03);
  border-radius: 18rpx;
  font-size: 29rpx;
  color: #1b2419;
}

.nickname-actions {
  display: flex;
  margin-top: 20rpx;
}

.nickname-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 27rpx;
}

.nickname-btn + .nickname-btn {
  margin-left: 16rpx;
}

/* ---------- 统计 ---------- */

.stat-row {
  display: flex;
}

.stat-item {
  flex: 1;
}

.stat-value {
  font-size: 46rpx;
  font-weight: 300;
  color: #1b2419;
  line-height: 1.2;
  letter-spacing: -1rpx;
}

/* ---------- 状态行 ---------- */

.status-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 14rpx 0;
}

.status-row .label {
  font-size: 26rpx;
  color: #7d8578;
  flex: none;
  margin-right: 24rpx;
}

.status-row .value {
  font-size: 26rpx;
  color: #1b2419;
  text-align: right;
  flex: 1;
  word-break: break-all;
}

.section-divider {
  height: 1rpx;
  background: rgba(27, 36, 25, 0.06);
  margin: 24rpx 0;
}

/* ---------- 链接行 ---------- */

.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 29rpx;
  color: #1b2419;
}

.link-arrow {
  color: #a8a89c;
  font-size: 34rpx;
  line-height: 1;
}

.logout-btn {
  margin-top: 8rpx;
}
