.page {
  min-height: 100vh;
  padding: 28rpx;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 12% 8%, rgba(255, 176, 145, 0.32), transparent 34%),
    radial-gradient(circle at 88% 10%, rgba(196, 170, 255, 0.28), transparent 36%),
    linear-gradient(180deg, #fff9f4 0%, #f7f1ff 52%, #fff7ef 100%);
}

.hero {
  padding: 34rpx 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #f59b88 0%, #b89af6 100%);
  color: #fffaf7;
  box-shadow: 0 18rpx 48rpx rgba(168, 132, 188, 0.18);
}

.hero-tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.68);
  color: #6a536f;
  font-size: 22rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.18;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 250, 247, 0.86);
}

.panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 253, 250, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 14rpx 40rpx rgba(168, 132, 188, 0.12);
  overflow: hidden;
}

.panel-title {
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #332a31;
}

.status-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(106, 83, 111, 0.08);
}

.status-row:last-child {
  border-bottom: none;
}

.label {
  flex: 0 0 auto;
  color: #81747d;
  font-size: 24rpx;
}

.value {
  color: #332a31;
  font-size: 24rpx;
  text-align: right;
  min-width: 0;
  word-break: break-word;
}

.multiline {
  flex: 1;
}

.actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
  width: 100%;
  overflow: hidden;
}

.control-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 18rpx;
  margin-bottom: 18rpx;
  width: 100%;
}

.primary,
.secondary {
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.35;
  min-width: 0;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 100%;
  padding-left: 16rpx;
  padding-right: 16rpx;
}

.primary {
  background: linear-gradient(135deg, #f59b88 0%, #b89af6 100%);
  color: #fffaf7;
}

.secondary {
  background: rgba(255, 255, 255, 0.72);
  color: #6a536f;
}

.metric {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.metric-value {
  font-size: 64rpx;
  font-weight: 700;
  color: #332a31;
}

.metric-label {
  color: #81747d;
  font-size: 24rpx;
}

.raw-block {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #fff1e9;
  color: #332a31;
  font-size: 22rpx;
  line-height: 1.6;
  word-break: break-all;
}

.wave-panel {
  overflow: hidden;
}

.wave-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.wave-title {
  margin-bottom: 6rpx;
}

.wave-source,
.wave-note {
  color: #756b78;
  font-size: 24rpx;
  line-height: 1.5;
}

.wave-reading {
  display: flex;
  flex: 0 0 auto;
  align-items: baseline;
  gap: 8rpx;
  color: #44384e;
}

.wave-value {
  font-size: 42rpx;
  font-weight: 700;
}

.wave-unit {
  font-size: 22rpx;
}

.live-wave-canvas {
  width: 100%;
  height: 320rpx;
  border: 1rpx solid rgba(114, 91, 130, 0.12);
  border-radius: 8rpx;
  background: #fffaf8;
}

.wave-note {
  margin-top: 16rpx;
}

.telemetry-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.telemetry-cell {
  display: flex;
  min-width: 0;
  min-height: 150rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f8f4f1;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
}

.telemetry-cell:nth-child(2n) {
  background: #eef6f4;
}

.telemetry-value {
  color: #332a31;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
  word-break: break-all;
}

.telemetry-value.compact {
  font-size: 28rpx;
}

.telemetry-unit,
.telemetry-label {
  color: #756b78;
  font-size: 20rpx;
}

.telemetry-unit {
  margin-top: 4rpx;
}

.telemetry-label {
  margin-top: 12rpx;
  line-height: 1.4;
}

.tip-text {
  color: #756a73;
  font-size: 24rpx;
  line-height: 1.7;
}

.calibration-guide {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background:
    radial-gradient(circle at 92% 12%, rgba(184, 154, 246, 0.22), transparent 42%),
    linear-gradient(135deg, rgba(255, 244, 238, 0.94), rgba(244, 250, 255, 0.9));
  border: 1rpx solid rgba(184, 154, 246, 0.18);
}

.guide-title {
  color: #332a31;
  font-size: 26rpx;
  font-weight: 700;
}

.guide-copy {
  margin-top: 10rpx;
  color: #5d535b;
  font-size: 24rpx;
  line-height: 1.65;
}

.guide-steps {
  margin-top: 12rpx;
  color: #8b5a73;
  font-size: 21rpx;
  font-weight: 700;
}

@media (max-width: 360px) {
  .actions {
    grid-template-columns: 1fr;
  }

  .wave-header {
    flex-direction: column;
  }

  .wave-reading {
    max-width: 100%;
  }
}
