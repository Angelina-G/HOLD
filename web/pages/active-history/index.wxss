.history-page {
  min-height: 100vh;
  padding: 28rpx;
  background:
    radial-gradient(circle at 12% 8%, rgba(255, 176, 145, 0.3), transparent 34%),
    radial-gradient(circle at 88% 12%, rgba(196, 170, 255, 0.26), transparent 36%),
    linear-gradient(180deg, #fff9f4 0%, #f7f1ff 52%, #fff7ef 100%);
}

.history-hero,
.history-card {
  border-radius: 28rpx;
  background: rgba(255, 253, 250, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 46rpx rgba(168, 132, 188, 0.12);
}

.history-empty {
  margin-top: 22rpx;
  padding: 34rpx 28rpx;
  border-radius: 16rpx;
  background: rgba(255, 253, 250, 0.94);
  border: 1rpx solid rgba(108, 89, 101, 0.1);
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #332a31;
}

.empty-copy {
  margin-top: 12rpx;
  color: #756a73;
  font-size: 24rpx;
  line-height: 1.7;
}

.history-hero {
  padding: 30rpx;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #332a31;
  line-height: 1.18;
}

.hero-subtitle {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #756a73;
}

.history-card {
  margin-top: 22rpx;
  padding: 28rpx;
}

.history-head,
.history-footer {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.history-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #fff0dc;
  color: #8c5c4f;
  font-size: 20rpx;
  font-weight: 700;
}

.history-title {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #332a31;
  line-height: 1.25;
}

.history-time {
  font-size: 22rpx;
  color: #81747d;
}

.history-copy {
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #5d535b;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 22rpx;
}

.metric-card {
  padding: 18rpx;
  border-radius: 20rpx;
  background: #fff6ef;
  min-width: 0;
}

.metric-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #332a31;
}

.metric-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #81747d;
}

.history-footer {
  margin-top: 22rpx;
  align-items: center;
}

.duration-chip,
.detail-link {
  font-size: 22rpx;
}

@media (max-width: 360px) {
  .metric-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .history-head,
  .history-footer {
    align-items: flex-start;
    flex-direction: column;
  }

  .history-time {
    overflow-wrap: anywhere;
  }
}

.duration-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f3efff;
  color: #6a536f;
}

.detail-link {
  color: #9b73db;
  font-weight: 700;
}
